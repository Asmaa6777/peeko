{
  "schemaVersion": 1,
  "presets": [
    {
      "id": "read-pdfs",
      "title": "Read for 30 minutes",
      "type": "appTime",
      "params": { "bundleIDs": ["com.apple.Preview"], "minutes": 30, "idleCutoffSeconds": 120 },
      "icon": "book"
    },
    {
      "id": "deep-work",
      "title": "Deep work for 90 minutes",
      "type": "appTime",
      "params": { "bundleIDs": ["com.microsoft.VSCode", "com.apple.Terminal"], "minutes": 90, "idleCutoffSeconds": 120 },
      "icon": "laptopcomputer"
    },
    {
      "id": "github-push",
      "title": "Push to GitHub",
      "type": "remoteCheck",
      "params": { "source": "githubPush", "username": "" },
      "icon": "arrow.up.circle"
    },
    {
      "id": "slept-on-time",
      "title": "Slept on time",
      "type": "activity",
      "params": { "rule": "quietBetween", "from": "00:30", "until": "05:00" },
      "icon": "moon.zzz"
    },
    {
      "id": "up-early",
      "title": "Up before 8",
      "type": "activity",
      "params": { "rule": "startBetween", "from": "04:00", "until": "08:00" },
      "icon": "sunrise"
    },
    {
      "id": "write-notes",
      "title": "Write in your notes",
      "type": "folderActivity",
      "params": { "path": "", "extensions": ["md", "markdown", "txt"], "minWords": 0 },
      "icon": "pencil.line"
    },
    {
      "id": "write-300",
      "title": "Write 300 words",
      "type": "folderActivity",
      "params": { "path": "", "extensions": ["md", "markdown", "txt"], "minWords": 300 },
      "icon": "doc.text"
    },
    {
      "id": "gym",
      "title": "Gym",
      "type": "manual",
      "params": {},
      "icon": "dumbbell"
    },
    {
      "id": "water",
      "title": "Drink water",
      "type": "manual",
      "params": {},
      "icon": "drop"
    }
  ]
}
